{
  // Cloudflare Workers config for serving the Carron site as static assets.
  // `npx next build` emits the static site to ./out (see next.config.mjs
  // `output: "export"`), and `npx wrangler deploy` uploads that folder.
  // No Worker script is needed — this is a pure static-assets deployment.
  //
  // NOTE: "name" must match the Worker's name shown at the top of your
  // Cloudflare project. If your Worker is named differently, change it here.
  "name": "carron-advisory",
  "compatibility_date": "2025-06-01",
  // Worker entry: serves the static site (via the ASSETS binding) and adds the
  // /api/health-check endpoint that records submissions to D1.
  "main": "worker/index.js",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // Serve out/404.html for unknown paths (Next.js export produces it).
    "not_found_handling": "404-page"
  },
  // D1 database that stores Health Check submission summaries (no raw figures).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "carron-health-check",
      "database_id": "1457ab6a-858a-4df8-a76d-7ef1d5d0c0c2"
    }
  ],
  // Attach the live domain. `custom_domain: true` makes Cloudflare create the
  // routing DNS record + SSL automatically on deploy. (Static-asset Workers
  // can't add domains via the dashboard Triggers screen, so we do it here.)
  "routes": [
    { "pattern": "carron.co.za", "custom_domain": true },
    { "pattern": "www.carron.co.za", "custom_domain": true }
  ]
}
